@@ -592,12 +649,75 @@ func (s *sisters) setupDo(ctx context.Context, h sisterHost, d rubiplugin.HomeDe
 		return nil, errors.New(oneLine(err.Error(), 200))
 	}
 	h.Audit(auditSetup, fields)
+	s.noteSetupActed(d.ID)
 	if res == nil {
 		res = map[string]any{"ok": true}
 	}
 	return res, nil
 }
 
+// noteSetupActed drops the cached status after a setup action and remembers what it showed,
+// so the next page is a fresh read and keeps refreshing until that picture changes.
+func (s *sisters) noteSetupActed(device string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.setupCaps == nil {
+		s.setupCaps = map[string]setupCap{}
+	}
+	e := s.setupCaps[device]
+	e.acted = true
+	e.actedAt = s.now()
+	e.actedFP = setupFingerprint(e.st)
+	e.sawChange = false
+	e.hasSt = false
+	e.gen++
+	s.setupCaps[device] = e
+}
+
+// observeSetupAction says whether the page should keep refreshing, and whether to say the action
+// is still starting because the status is the one from before it.
+func (s *sisters) observeSetupAction(device string, st setupStatus) (watching, starting bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e := s.setupCaps[device]
+	if !e.acted {
+		return false, false
+	}
+	changed := setupFingerprint(st) != e.actedFP
+	if changed {
+		e.sawChange = true
+	}
+	// Nothing visible has moved, and the page is not already showing a running step or a
+	// sign-in the user must finish. Say that the action is starting and keep looking.
+	// A sign-in that is already waiting (opening the link does not change the status) is
+	// settled: a second "Starting" box would only repeat it.
+	if !e.sawChange && !st.busy() && st.Login == nil && !s.now().After(e.actedAt.Add(setupActWatch)) {
+		s.setupCaps[device] = e
+		return true, true
+	}
+	e.acted = false
+	s.setupCaps[device] = e
+	return false, false
+}
+
+// setupFingerprint is the part of a status the page shows, so a change is a visible one.
+func setupFingerprint(st setupStatus) string {
+	var b strings.Builder
+	if st.Job != nil {
+		b.WriteString("job:" + st.Job.Step + "/" + st.Job.Project + ";")
+	}
+	if st.Login != nil {
+		b.WriteString("login:" + st.Login.URL + ";")
+	}
+	for _, step := range st.Steps {
+		b.WriteString(step.ID + "=" + step.State + "/" + step.Action + "/" + step.Reason + ";")
+		for _, pr := range step.Projects {
+			b.WriteString(pr.ID + "=" + pr.State + "/" + pr.Reason + ";")
+		}
+	}
+	return b.String()
+}
+
 func (s *sisters) executeSetupInstall(ctx context.Context, h sisterHost, t setupTicket) (any, error) {
 	return s.executeSetup(ctx, h, t, opSetupRun, map[string]any{"step": "container"}, "install the container tool", panelListTimeout)
 }
