+// stepTitle is the name of a step: Rubi Home's own title, then the shared fallback.
+func stepTitle(key, title string) string {
+	return firstNonEmpty(oneLine(title, 60), setupTitles[key], oneLine(key, 40))
+}
+
+// loginLabel is the sign-in button. A failed sign-in starts over, so the button says so.
+func loginLabel(action, state string) string {
+	if action == "login_again" {
+		return "Sign in again"
+	}
+	if state == "failed" {
+		return "Get a new sign-in link"
+	}
+	return "Sign in"
+}
