# The guest kernel, both CPUs: merged onto allnoconfig. Everything is built in (there are no modules, and the root file
# system is read-only); there is no network card, only loopback. check-kernel-config.sh fails the build when an option
# here didn't make it into the final configuration.
# CONFIG_MODULES is not set
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FILE_LOCKING=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SMP=y
CONFIG_BINFMT_ELF=y
# The live test's probe boots from an initramfs (uncompressed); Rubi's VMs boot from the root disk
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# The tools' own sandboxes (bubblewrap) and seccomp filters
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# Loopback only: the proxy and the hook gate reach Home over the control channel
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# no IPv6-in-IPv4 tunnel device (sit0): lo stays the only interface
# CONFIG_IPV6_SIT is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
# File systems: the read-only root, the shares, the tmpfs places
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# The devices of the command line (microvm.QEMUArgs)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_MMIO=y
