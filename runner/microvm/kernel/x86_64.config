# x86-64: the microvm machine. qboot starts the kernel through its PVH entry (an ELF vmlinux); the console is the ISA
# serial port; the machine has no ACPI (acpi=off): QEMU names the virtio-mmio devices on the kernel command line and the
# interrupt controller is in the MP table.
CONFIG_64BIT=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y
# CONFIG_ACPI is not set
CONFIG_X86_MPPARSE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# CONFIG_IA32_EMULATION is not set
