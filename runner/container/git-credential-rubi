#!/bin/sh
# git credential helper inside the runner VM. Forwards `git credential <op>` to the runner, which passes
# it to Rubi Home as a git.credential request (a push is marked purpose=push by the runner).
# Protocol on the socket: first line the operation, then git's key=value lines; the reply is git's text.
op="$1"
sock="${RUBI_CRED_SOCK:-/tmp/rubi-cred.sock}"
case "$op" in get|store|erase) ;; *) exit 0 ;; esac
{ printf '%s\n' "$op"; cat; } | nc -U -w 300 "$sock"
