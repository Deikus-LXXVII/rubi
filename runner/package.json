{
  "name": "rubi-agent-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Rubi agent runner: line-delimited JSON-RPC over stdio in front of the Claude Agent SDK",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "test:integration": "tsc && RUBI_RUNNER_INTEGRATION=1 node --test --test-timeout=240000 dist/test/integration.test.js",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
